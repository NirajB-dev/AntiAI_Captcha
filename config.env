# Motor-Timing CAPTCHA Configuration
# ===================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5001
DEBUG_MODE=True

# Security Thresholds
HUMAN_CONFIDENCE_THRESHOLD=0.6
ESCALATION_THRESHOLD=0.3
FINGERPRINT_RISK_THRESHOLD=0.7

# Model Configuration
ADVANCED_MODEL_ENABLED=True
MODEL_RETRAINING_THRESHOLD=50
FEATURE_COUNT=30

# Proof-of-Work Configuration
POW_DIFFICULTY_LOW=1
POW_DIFFICULTY_MEDIUM=2
POW_DIFFICULTY_HIGH=4
POW_TIMEOUT=30

# Training Configuration
MIN_TRAINING_SAMPLES=50
MAX_TRAINING_SAMPLES=10000
CROSS_VALIDATION_FOLDS=5

# File Paths (relative to project root)
MODELS_DIR=models
DATA_DIR=data
STATIC_DIR=static
FRONTEND_DIR=src/frontend

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT='%(asctime)s - %(name)s - %(levelname)s - %(message)s'

# Performance Configuration
CACHE_MODEL_IN_MEMORY=True
FEATURE_EXTRACTION_TIMEOUT=5
PREDICTION_TIMEOUT=1
